<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_peserta" pageWidth="595" pageHeight="842" columnWidth="525" leftMargin="35" rightMargin="35" topMargin="20" bottomMargin="20">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="SIKURSUS MySQL"/>
    <queryString>
        <![CDATA[SELECT id_peserta, nim, nama, jenis_kelamin, prodi, no_hp, email FROM peserta ORDER BY nama ASC]]>
    </queryString>
    <field name="id_peserta" class="java.lang.Integer"/>
    <field name="nim" class="java.lang.String"/>
    <field name="nama" class="java.lang.String"/>
    <field name="jenis_kelamin" class="java.lang.String"/>
    <field name="prodi" class="java.lang.String"/>
    <field name="no_hp" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <title>
        <band height="70" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="10" width="525" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN DATA PESERTA KURSUS]]></text>
